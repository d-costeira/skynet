# Copy to .env (git ignores it) and fill in the secrets:
#   cp .env.example .env && chmod 600 .env
# Generate a key with:  openssl rand -hex 32

# --- Secrets ---------------------------------------------------------------
# Key LiteLLM uses to talk to vLLM. Clients never see it.
VLLM_API_KEY=
# Admin key for LiteLLM; also the key clients use until per-client keys exist.
# LiteLLM expects it to start with "sk-", e.g. sk-<output of openssl rand -hex 32>
LITELLM_MASTER_KEY=

# --- Images (pinned by digest) ---------------------------------------------
# vLLM v0.30.0 (2026-09-22, CUDA 13.0, needs driver 580+). Same as skynet.conf.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0@sha256:8a69ffad015f138d7170c4ddc429e230a3bc1c1719f67e14324749df200a4b90
# LiteLLM stable release from the official image (not PyPI; see the March 2026
# PyPI compromise noted in both proposals).
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.83.14-stable@sha256:c81eb79cd4333c6cfe374c0ec929110fd23f0ee5f7fd198855a6fbddc77b83ba

# --- Model -----------------------------------------------------------------
MODELS_DIR=/srv/models
MODEL_DIR_NAME=Qwen3.8-27B-AWQ-INT4

# --- vLLM tuning -----------------------------------------------------------
# Which file in vllm-profiles/ to start with: mtp-off or mtp-on.
VLLM_PROFILE=mtp-off
# Fraction of each card's 24 GB that vLLM may use (weights + KV cache).
# Coding plan: 0.92. House plan: 0.78 (leaves ~5 GB per card for speech models).
GPU_MEMORY_UTILIZATION=0.92
# Longest context per request, in tokens.
# Coding plan: 262144. House plan: 65536.
MAX_MODEL_LEN=262144
